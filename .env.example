# Copy to `.env` and fill in. `.env` is gitignored and .dockerignored; this file
# is committed and must never hold a real value.
#
#     cp .env.example .env
#
# Every value below is a placeholder. Deploying this file verbatim is designed to
# fail, and it fails in two places on purpose:
#
#   1. `docker compose up` refuses when a required variable is unset — the
#      `${VAR:?...}` syntax in docker-compose.yml.
#   2. `app/platform/config.py::_no_published_secrets` refuses to construct
#      `Settings` at all when ENVIRONMENT is not `development` and JWT_SECRET or
#      TURN_SECRET is under 32 characters or still holds the value printed in
#      that file. It raises before the FastAPI application object exists, so the
#      failure is a container that will not start — not a process that serves
#      traffic and mints forgeable tokens.
#
# That second one is the behaviour you want. `jwt_secret` signs every access
# token AND derives the media-grant key and the competition payload key; a
# deployment that forgot it lets anyone who has read this repository mint an
# access token for any user, including a platform admin.

# ── secrets ──────────────────────────────────────────────────────────────────
# Generate each one SEPARATELY — they must not be the same value:
#
#     python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# That is the command `config.py` names in its own error message. `token_urlsafe`
# rather than `openssl rand -base64` because the output is [A-Za-z0-9_-] with no
# `+` or `/`, which matters for POSTGRES_PASSWORD below: it is substituted into a
# connection URL, and `migrations/env.py` documents what a `%` or a `/` in that
# string does to a deploy.

# Signs access tokens; derives media grants and competition payload keys.
# Rotating it logs everyone out and invalidates every outstanding media URL.
JWT_SECRET=CHANGE_ME

# Signs TURN credentials. Published, this is an open relay billed to you, and
# TURN bandwidth is the one line item in this budget that scales with usage.
TURN_SECRET=CHANGE_ME

# The database password. NOTE: unlike the two above, nothing in the application
# refuses to start on a weak one — the gate is only on the two it can check. This
# is the value you have to remember to change yourself. Changing it later means
# `ALTER ROLE ielts PASSWORD ...` inside the running container as well as here,
# because the volume already holds the initialised cluster and
# POSTGRES_PASSWORD is only read on first boot.
POSTGRES_PASSWORD=CHANGE_ME

# ── the box ──────────────────────────────────────────────────────────────────

# The public hostname. DNS must already point at this machine before the first
# `up`, or the ACME challenge cannot complete and Caddy serves nothing.
DOMAIN=ielts.example.uz

# Where Let's Encrypt sends expiry and policy notices. A real inbox you read.
ACME_EMAIL=ops@example.uz

# ── pilot sign-in ────────────────────────────────────────────────────────────
#
# LEAVE THIS UNSET UNLESS YOU ARE RUNNING A PILOT, AND UNSET IT AGAIN AFTERWARDS.
#
# There is no SMS provider — `app/modules/identity/transport.py` implements
# Telegram and fails closed on SMS rather than pretending — so a login code
# reaches an account only over Telegram. A first prep centre is forty students
# with no Telegram link and no way in on day one, which is the only problem this
# solves.
#
# With it on, `POST /auth/otp/request` returns the login code in its own
# response. That means ANYONE WHO KNOWS A PHONE NUMBER CAN SIGN IN AS THAT
# PERSON — a student, a teacher, a platform admin. For one centre with a roster
# you control it is a considered trade; anywhere else it is the authentication
# system switched off.
#
# It announces itself: a warning at every boot, and an `audit_log` row per code
# issued, so "was it on, and for how long" is a query rather than a memory.
#
#   SELECT count(*), min(at), max(at) FROM audit_log
#    WHERE action = 'auth.pilot_code_issued';
#
# PILOT_OPEN_SIGNIN=true

# ── TURN / STUN ──────────────────────────────────────────────────────────────
# Not deployed by docker-compose.yml. coturn belongs on a separate small Tashkent
# VPS (ADR-0001 §3.2) so that two peers in Tashkent are not relayed through
# Finland — 120 ms of pointless latency on a product whose entire point is
# conversational turn-taking. Audio never touches this box either way.
TURN_URL=turn:turn.example.uz:3478

# The default is Google's public STUN. It works and it is free; it is also a
# third-party dependency in the connection path of a product with a data
# residency constraint, so point it at your own coturn once it exists.
STUN_URL=stun:stun.l.google.com:19302

# ── integrations ─────────────────────────────────────────────────────────────
# All four may be left empty. The endpoints that need them REFUSE rather than
# degrade, which is the correct behaviour for an authentication path and for a
# callback that marks orders paid — so an incomplete deployment is a feature
# that returns an error, not a feature that silently accepts anything.

# Telegram Mini App. `initData` is HMAC'd with a key derived from the BOT TOKEN,
# so this is not interchangeable with JWT_SECRET: signing with our own secret
# would validate data we signed ourselves, which verifies nothing.
TELEGRAM_BOT_TOKEN=

# Payment callbacks. Shared-secret authenticated rather than IP-allowlisted,
# because a VPS provider's egress addresses are not a security boundary.
PAYME_MERCHANT_KEY=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=0
