{
  "name": "ielts-hub-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Admin console for the IELTS hub. Centre staff surface only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit",
    "codegen": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "5.62.7",
    "openapi-fetch": "0.13.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  }
}
