{
  "_comment": "ACCEPTANCE TEST ARTIFACT. This is a question type that does NOT ship at MVP. Copy it into registry/question_types/ and run `ielts qtypes sync` to add it to a running production system. No migration. No exam-engine change. See docs/design/0002-data-model.md section 4 for the full walkthrough.",

  "key": "matching_sentence_endings",
  "version": 1,
  "status": "active",
  "title": "Matching sentence endings",
  "description": "Complete each sentence stem by choosing an ending from a shared list. Each ending is used at most once, and the list contains more endings than stems.",
  "skills": ["reading"],

  "payload_schema": {
    "type": "object",
    "required": ["stem"],
    "additionalProperties": false,
    "properties": {
      "stem": {
        "type": "string",
        "minLength": 1,
        "description": "The opening half of the sentence, e.g. 'The earliest maps were produced'."
      },
      "paragraph_hint": { "type": "string", "pattern": "^[A-Z]$" }
    }
  },

  "key_schema": {
    "type": "object",
    "required": ["slots"],
    "additionalProperties": false,
    "properties": {
      "slots": {
        "type": "object",
        "required": ["s1"],
        "additionalProperties": false,
        "properties": {
          "s1": {
            "type": "object",
            "required": ["accept"],
            "additionalProperties": false,
            "properties": {
              "accept": {
                "type": "array", "minItems": 1, "maxItems": 1,
                "items": { "type": "string", "pattern": "^[A-J]$" }
              }
            }
          }
        }
      }
    }
  },

  "response_schema": {
    "type": "object",
    "required": ["slots"],
    "additionalProperties": false,
    "properties": {
      "slots": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
    }
  },

  "scoring": {
    "primitive": "choice_per_slot",
    "options": {
      "option_source": "group.option_bank",
      "unique_options": true,
      "aggregate": "per_slot",
      "points_per_slot": 1
    },
    "normalizers": ["trim", "casefold"]
  },

  "validation": {
    "rules": [
      { "rule": "option_bank_present" },
      { "rule": "key_values_in_option_set", "source": "group.option_bank" },
      { "rule": "no_duplicate_key_values" },
      {
        "rule": "option_bank_at_least",
        "offset": 2,
        "reason": "IELTS sentence-ending lists always carry spare distractors, otherwise the final stems answer themselves"
      }
    ]
  },

  "authoring": {
    "icon": "arrow-right",
    "group_scoped": true,
    "form": [
      { "field": "stem", "widget": "text", "label": { "en": "Sentence beginning", "ru": "Начало предложения", "uz-Latn": "Gap boshlanishi" } },
      { "field": "paragraph_hint", "widget": "paragraph_picker", "optional": true }
    ],
    "group_form": [
      {
        "field": "option_bank",
        "widget": "option_list",
        "auto_letter": true,
        "label": { "en": "List of endings" },
        "min": 3,
        "max": 10
      }
    ],
    "key_widget": "option_picker",
    "preview": "matching_features"
  }
}
