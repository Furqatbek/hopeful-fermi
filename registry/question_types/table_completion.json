{
  "key": "table_completion",
  "version": 1,
  "status": "active",
  "title": "Table completion",
  "description": "A table with some cells blank. Structure is data, so the same type serves Reading tables and Listening booking/price tables.",
  "skills": ["reading", "listening"],
  "payload_schema": {
    "type": "object",
    "required": ["columns", "rows", "slots"],
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string" },
      "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "rows": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "array",
          "items": {
            "type": "object", "required": ["kind"], "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["text", "blank"] },
              "value": { "type": "string" },
              "slot": { "type": "string", "pattern": "^s[0-9]+$" }
            }
          }
        }
      },
      "slots": {
        "type": "array", "minItems": 1, "maxItems": 20,
        "items": { "type": "string", "pattern": "^s[0-9]+$" }
      },
      "audio_hint_ms": { "type": "integer", "minimum": 0 }
    }
  },
  "key_schema": {
    "type": "object", "required": ["slots"], "additionalProperties": false,
    "properties": {
      "slots": {
        "type": "object", "minProperties": 1,
        "additionalProperties": {
          "type": "object", "required": ["accept"], "additionalProperties": false,
          "properties": {
            "accept": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "case_sensitive": { "type": "boolean", "default": false },
            "normalizers": { "type": "array", "items": { "type": "string" } },
            "word_limit": { "type": "object" }
          }
        }
      }
    }
  },
  "response_schema": {
    "type": "object", "required": ["slots"], "additionalProperties": false,
    "properties": {
      "slots": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
    }
  },
  "scoring": {
    "primitive": "text_per_slot",
    "options": { "aggregate": "per_slot", "points_per_slot": 1, "apply_word_limit": true },
    "normalizers": [
      "trim", "collapse_space", "casefold", "strip_punctuation",
      "hyphen_flexible", "strip_articles", "contraction_expand",
      "spelling_uk_us", "number_word", "ordinal_digit"
    ]
  },
  "validation": {
    "rules": [
      { "rule": "key_slots_match_payload_slots" },
      { "rule": "table_slots_declared", "source": "payload.rows" },
      { "rule": "table_rows_match_columns" },
      { "rule": "word_limit_present_on_group" },
      { "rule": "accepted_answers_within_word_limit", "severity": "error" }
    ]
  },
  "authoring": {
    "icon": "table",
    "multi_slot": true,
    "form": [
      { "field": "title", "widget": "text", "optional": true },
      { "field": "rows", "widget": "table_builder",
        "hint": { "en": "Click any cell and press Insert blank to turn it into a numbered gap." },
        "paste_from": ["docx_table", "tsv"] }
    ],
    "group_form": [{ "field": "word_limit", "widget": "word_limit_builder", "required": true }],
    "key_widget": "slot_alternatives_grid",
    "preview": "table"
  }
}
