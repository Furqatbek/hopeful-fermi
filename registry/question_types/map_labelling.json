{
  "key": "map_labelling",
  "version": 1,
  "status": "active",
  "title": "Map / plan labelling (choose from list)",
  "description": "Place lettered labels on a map or floor plan. Scored as option matching against the group's option bank.",
  "skills": ["listening", "reading"],
  "payload_schema": {
    "type": "object",
    "required": ["slots"],
    "additionalProperties": false,
    "properties": {
      "caption": { "type": "string" },
      "slots": {
        "type": "array", "minItems": 1, "maxItems": 12,
        "items": {
          "type": "object", "required": ["key", "label"], "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "pattern": "^s[0-9]+$" },
            "label": { "type": "string", "description": "What the student is locating, e.g. 'Car park'." }
          }
        }
      },
      "audio_hint_ms": { "type": "integer", "minimum": 0 }
    }
  },
  "key_schema": {
    "type": "object", "required": ["slots"], "additionalProperties": false,
    "properties": {
      "slots": {
        "type": "object", "minProperties": 1,
        "additionalProperties": {
          "type": "object", "required": ["accept"], "additionalProperties": false,
          "properties": {
            "accept": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "response_schema": {
    "type": "object", "required": ["slots"], "additionalProperties": false,
    "properties": {
      "slots": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
    }
  },
  "scoring": {
    "primitive": "choice_per_slot",
    "options": {
      "option_source": "group.option_bank",
      "unique_options": true,
      "aggregate": "per_slot",
      "points_per_slot": 1
    },
    "normalizers": ["trim", "casefold"]
  },
  "validation": {
    "rules": [
      { "rule": "key_slots_match_payload_slots" },
      { "rule": "group_has_diagram_media" },
      { "rule": "diagram_media_ready" },
      { "rule": "hotspots_cover_option_bank", "source": "group.hotspots",
        "reason": "every lettered position on the map must actually exist on the image" },
      { "rule": "option_bank_present" },
      { "rule": "key_values_in_option_set", "source": "group.option_bank" },
      { "rule": "no_duplicate_key_values" }
    ]
  },
  "authoring": {
    "icon": "map-pin",
    "group_scoped": true,
    "form": [
      { "field": "caption", "widget": "text", "optional": true },
      { "field": "slots", "widget": "label_slot_list",
        "hint": { "en": "One row per thing the student must find on the map." } }
    ],
    "group_form": [
      { "field": "diagram_media_id", "widget": "image_upload", "required": true,
        "accept": ["image/png", "image/jpeg", "image/webp"], "max_bytes": 4194304 },
      { "field": "option_bank", "widget": "option_list", "auto_letter": true,
        "label": { "en": "Lettered positions on the map" } },
      { "field": "hotspots", "widget": "hotspot_placer", "bind_to": "option_bank",
        "hint": { "en": "Drop a letter onto each marked position. Coordinates are fractions of the image, so they survive resizing." } }
    ],
    "key_widget": "slot_to_bank_grid",
    "preview": "map"
  }
}
