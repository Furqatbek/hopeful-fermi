{
  "key": "summary_completion_bank",
  "version": 1,
  "status": "active",
  "title": "Summary completion (with word bank)",
  "description": "A prose summary with blanks filled by selecting from a shared list of words. Scored as option matching, not free text.",
  "skills": ["reading", "listening"],
  "payload_schema": {
    "type": "object",
    "required": ["summary", "slots"],
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string" },
      "summary": { "type": "string", "minLength": 1 },
      "slots": {
        "type": "array", "minItems": 1, "maxItems": 12,
        "items": { "type": "string", "pattern": "^s[0-9]+$" }
      }
    }
  },
  "key_schema": {
    "type": "object", "required": ["slots"], "additionalProperties": false,
    "properties": {
      "slots": {
        "type": "object", "minProperties": 1,
        "additionalProperties": {
          "type": "object", "required": ["accept"], "additionalProperties": false,
          "properties": {
            "accept": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "response_schema": {
    "type": "object", "required": ["slots"], "additionalProperties": false,
    "properties": {
      "slots": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
    }
  },
  "scoring": {
    "primitive": "choice_per_slot",
    "options": {
      "option_source": "group.option_bank",
      "unique_options": "from_group",
      "aggregate": "per_slot",
      "points_per_slot": 1
    },
    "normalizers": ["trim", "casefold"]
  },
  "validation": {
    "rules": [
      { "rule": "key_slots_match_payload_slots" },
      { "rule": "blank_markers_match_slots", "source": "payload.summary" },
      { "rule": "option_bank_present" },
      { "rule": "key_values_in_option_set", "source": "group.option_bank" },
      { "rule": "option_bank_at_least", "offset": 2,
        "reason": "a word bank with no spare distractors makes the last blanks free" }
    ]
  },
  "authoring": {
    "icon": "layout-grid",
    "group_scoped": true,
    "multi_slot": true,
    "form": [
      { "field": "title", "widget": "text", "optional": true },
      { "field": "summary", "widget": "blank_editor", "multiline": true }
    ],
    "group_form": [
      { "field": "option_bank", "widget": "option_list", "auto_letter": true,
        "label": { "en": "Word bank" }, "min": 3, "max": 16 }
    ],
    "key_widget": "slot_to_bank_grid",
    "preview": "summary_bank",
    "note": { "en": "Because students choose from a list, no word limit applies and spelling tolerance is irrelevant here." }
  }
}
