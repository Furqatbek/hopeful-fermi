{
  "key": "matching_features",
  "version": 1,
  "status": "active",
  "title": "Matching features",
  "description": "Match each statement, name, place or item to a feature from a shared list. Options may be reused unless the group says otherwise. Also covers Listening 'matching' sets.",
  "skills": ["reading", "listening"],
  "payload_schema": {
    "type": "object",
    "required": ["stem"],
    "additionalProperties": false,
    "properties": {
      "stem": { "type": "string", "minLength": 1 },
      "audio_hint_ms": { "type": "integer", "minimum": 0 }
    }
  },
  "key_schema": {
    "type": "object", "required": ["slots"], "additionalProperties": false,
    "properties": {
      "slots": {
        "type": "object", "required": ["s1"], "additionalProperties": false,
        "properties": {
          "s1": {
            "type": "object", "required": ["accept"], "additionalProperties": false,
            "properties": {
              "accept": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "response_schema": {
    "type": "object", "required": ["slots"], "additionalProperties": false,
    "properties": {
      "slots": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
    }
  },
  "scoring": {
    "primitive": "choice_per_slot",
    "options": {
      "option_source": "group.option_bank",
      "unique_options": "from_group",
      "aggregate": "per_slot",
      "points_per_slot": 1
    },
    "normalizers": ["trim", "casefold"]
  },
  "validation": {
    "rules": [
      { "rule": "key_values_in_option_set", "source": "group.option_bank" },
      { "rule": "option_bank_present" }
    ]
  },
  "authoring": {
    "icon": "link",
    "group_scoped": true,
    "form": [
      { "field": "stem", "widget": "text", "label": { "en": "Item to match" } },
      { "field": "audio_hint_ms", "widget": "audio_timestamp", "optional": true, "skills": ["listening"] }
    ],
    "group_form": [
      { "field": "option_bank", "widget": "option_list", "auto_letter": true, "label": { "en": "List of features" } },
      { "field": "display.unique_options", "widget": "toggle", "default": false, "label": { "en": "Each feature may be used once only" } }
    ],
    "key_widget": "option_picker",
    "preview": "matching_features"
  }
}
