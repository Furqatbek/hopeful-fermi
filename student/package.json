{
  "name": "ielts-hub-student",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit",
    "codegen": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "5.62.7",
    "openapi-fetch": "0.13.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "openapi-typescript": "7.4.4",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "6.0.5",
    "vitest": "^2.1.8"
  }
}
